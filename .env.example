# Copy this file to .env and fill in the values for local telemetry testing.
# .env is gitignored and must never be committed.
#
# TELEMETRY_CLIENT_TOKEN is injected at build time via -X main.telemetryClientToken.
# In production builds this is set by CI. Locally, set it here or export it:
#   export DD_CODE_SECURITY_TELEMETRY_TOKEN=<your-token>  (runtime fallback, no rebuild needed)
TELEMETRY_CLIENT_TOKEN=

# TELEMETRY_ENV controls the env: tag in ddtags.
# Use "development" locally, "production" in release builds.
TELEMETRY_ENV=development
